# --- Runtime -------------------------------------------------------------
# development | test | production  (production requires JWT_SECRET, ADMIN_PASSWORD)
ENVIRONMENT=development

# --- Database ------------------------------------------------------------
# Docker Compose overrides this to point at the `postgres` service.
DATABASE_URL=postgresql+psycopg://isker:isker@localhost:5432/isker
POSTGRES_USER=isker
POSTGRES_PASSWORD=isker
POSTGRES_DB=isker

# --- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=1440
# Empty = automatic (Secure cookies in production, plain cookies on http://localhost in development).
COOKIE_SECURE=
# Public URL of the web app, used in email links (verification, password reset).
APP_BASE_URL=http://localhost:5173
# Sign-in is refused for unconfirmed emails when true. Enable only once email delivery works.
REQUIRE_EMAIL_VERIFICATION=false
TERMS_VERSION=2026-10

# --- Email ---------------------------------------------------------------
# auto | smtp | console | disabled
#   auto    = smtp when SMTP_HOST is set; otherwise console in development and disabled in production
#   console = development only: emails (with their links) are written to the server log, never delivered.
#             The app says so in the UI instead of claiming an email was sent. Refused in production.
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Isker <no-reply@isker.local>
SMTP_STARTTLS=true

# --- Abuse protection ----------------------------------------------------
# In-memory, per process. Use a shared store (e.g. Redis) before running several API processes.
RATE_LIMIT_ENABLED=true
MAX_REQUEST_BYTES=1000000

# --- Payments ------------------------------------------------------------
# No payment provider is integrated. Plans are granted by admins. Signed webhooks are accepted at
# /api/billing/webhooks/<PAYMENT_PROVIDER> only when both values are set (see app/services/payments.py).
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- AI ------------------------------------------------------------------
# MOCK_AI=true uses the deterministic rubric provider (no network, no key).
# Set MOCK_AI=false and OPENAI_API_KEY to use OpenAI. Keys never reach the frontend.
MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- CORS (comma separated explicit origins; "*" is refused) ------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Seed ----------------------------------------------------------------
# In development, empty passwords fall back to documented dev defaults.
# In production, accounts are only created when a password is provided.
SEED_DEMO=true
DEMO_EMAIL=demo@isker.local
DEMO_PASSWORD=
ADMIN_EMAIL=admin@isker.local
ADMIN_PASSWORD=
