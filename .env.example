# Isker configuration. Copy to .env for local development (cp .env.example .env); every value here is a safe
# development default or empty. NEVER commit .env or real secrets (.env is in .gitignore).
#
# Where each environment gets its values (details: DEPLOYMENT.md):
#   development  .env in the repository root (or nothing: built-in defaults work with a local PostgreSQL)
#   CI           .github/workflows/ci.yml sets test-only values; no secrets are needed
#   preview      Render preview environment: same settings as production (render.yaml) + its own new database
#   production   Render dashboard → service "isker" → Environment (secrets are entered there, never in Git)

# --- Runtime -------------------------------------------------------------
# development | test | production  (production requires JWT_SECRET, ADMIN_PASSWORD)
ENVIRONMENT=development

# --- Database ------------------------------------------------------------
# Docker Compose overrides this to point at the `postgres` service.
DATABASE_URL=postgresql+psycopg://isker:isker@localhost:5432/isker
POSTGRES_USER=isker
POSTGRES_PASSWORD=isker
POSTGRES_DB=isker

# --- Auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Sessions (docs/authentication.md). Without "Remember me": browser-session cookie, server session ends after
# SESSION_HOURS. With "Remember me": persistent cookie and session for REMEMBER_ME_DAYS. The session token is
# rotated after TOKEN_ROTATE_MINUTES; replaying an older token revokes the session.
SESSION_HOURS=12
REMEMBER_ME_DAYS=30
TOKEN_ROTATE_MINUTES=60
# Empty = automatic (Secure cookies in production, plain cookies on http://localhost in development).
COOKIE_SECURE=
# Public URL of the web app, used in email links (verification, password reset).
APP_BASE_URL=http://localhost:5173
# Sign-in is refused for unconfirmed emails when true. Enable only once email delivery works.
REQUIRE_EMAIL_VERIFICATION=false
TERMS_VERSION=2026-10

# --- Google sign-in (OpenID Connect) -------------------------------------------------
# Both values are required to enable "Continue with Google"; the secret stays on the server.
# Register this exact redirect URI in Google Cloud: {APP_BASE_URL}/api/auth/google/callback
# (or set GOOGLE_REDIRECT_URI explicitly). See docs/google-oauth-setup.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Email ---------------------------------------------------------------
# auto | smtp | console | disabled
#   auto    = smtp when SMTP_HOST is set; otherwise console in development and disabled in production
#   console = development only: emails (with their links) are written to the server log, never delivered.
#             The app says so in the UI instead of claiming an email was sent. Refused in production.
EMAIL_BACKEND=auto
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Isker <no-reply@isker.local>
SMTP_STARTTLS=true

# --- Proxy / serving --------------------------------------------------------
# Number of reverse proxies in front of the API that append to X-Forwarded-For (Render: 1, nginx compose: 1,
# API exposed directly: 0). Used to find the real client IP for rate limits.
TRUSTED_PROXY_HOPS=1
# Directory with the built frontend served by the API on the same origin (set in the production Docker image).
# Leave empty in development: the Vite dev server serves the frontend.
STATIC_DIR=

# --- Abuse protection ----------------------------------------------------
# In-memory, per process. Use a shared store (e.g. Redis) before running several API processes.
RATE_LIMIT_ENABLED=true
# Interactive API docs (/api/docs, /api/redoc, /api/openapi.json). Unset = on outside production, off in production.
# API_DOCS_ENABLED=true
MAX_REQUEST_BYTES=1000000

# --- Payments ------------------------------------------------------------
# No payment provider is integrated. Plans are granted by admins. Signed webhooks are accepted at
# /api/billing/webhooks/<PAYMENT_PROVIDER> only when both values are set (see app/services/payments.py).
PAYMENT_PROVIDER=
PAYMENT_WEBHOOK_SECRET=

# --- AI ------------------------------------------------------------------
# MOCK_AI=true uses the deterministic rubric provider (no network, no key).
# Set MOCK_AI=false and OPENAI_API_KEY to use OpenAI. Keys never reach the frontend.
MOCK_AI=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- CORS (comma separated explicit origins; "*" is refused) ------------
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Seed ----------------------------------------------------------------
# In development, empty passwords fall back to documented dev defaults.
# In production, accounts are only created when a password is provided.
SEED_DEMO=true
DEMO_EMAIL=demo@isker.local
DEMO_PASSWORD=
# The demo password is public: its password, email, Google link and status can't be changed through the account.
DEMO_READ_ONLY=true
ADMIN_EMAIL=admin@isker.local
ADMIN_PASSWORD=

# --- Frontend build-time variables (read by Vite; never put secrets here, they end up in the browser) -------
# Public support address shown on the landing and legal pages; empty = no address is shown.
VITE_SUPPORT_EMAIL=
# Show the demo account hint on the landing page (demo/staging sites only).
VITE_SHOW_DEMO=false
# Development only, set as an environment variable (not read from .env): where the Vite dev server forwards /api.
# Default http://localhost:8000; scripts/dev.sh and docker-compose.dev.yml set it for you.
# VITE_API_PROXY=http://localhost:8000
# Only for an interface hosted on another site than the API (GitHub Pages; set by .github/workflows/pages.yml):
# the API's public URL, and the path the interface is served under. Leave empty for the normal one-site setup.
# VITE_API_BASE_URL=https://isker.onrender.com
# VITE_BASE_PATH=/isker/
